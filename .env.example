# Examples only; the process manager must set these (no implicit dotenv loader).
MOMIQ_ENV=local
MOMIQ_HOST=127.0.0.1
MOMIQ_PORT=8080
MOMIQ_ALLOW_TEST_LOGIN=1
# MOMIQ_DATA_DIR=/absolute/path/for/this/environment
# MOMIQ_ADMIN_DIR=/absolute/path/to/momiq_admin
# Staging: explicit separate data dir, HTTPS proxy, optionally test login = 1.
# Production: explicit separate data dir, MOMIQ_ALLOW_TEST_LOGIN=0 mandatory.
