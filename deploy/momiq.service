[Unit]
Description=Momiq API (Gunicorn)
After=network.target
[Service]
User=momiq
Group=momiq
WorkingDirectory=/opt/momiq/current/backend
EnvironmentFile=/etc/momiq/backend.env
ExecStart=/opt/momiq/current/backend/.venv/bin/gunicorn --config /opt/momiq/current/backend/gunicorn.conf.py --bind 127.0.0.1:8080 --workers 2 --threads 4 --timeout 150 --access-logfile - --error-logfile - wsgi:application
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/momiq
[Install]
WantedBy=multi-user.target
